ENVIRONMENT=development

# Network Port Configuration
APP_PORT=8088
BACKEND_PORT=8000
FRONTEND_PORT=4200
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:8088,http://localhost:8088

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hey_you_should_tots_replace_this_to_a_strong_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=provenance_vault

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_COMMAND_TIMEOUT_SECONDS=30.0

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO Server & Storage Engine
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=provenance-covers
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000/provenance-covers

# Image Processing & Media Compression
COVER_IMAGE_MAX_DIMENSION=500
ENTITY_IMAGE_MAX_DIMENSION=800
IMAGE_JPEG_QUALITY=85

# Cryptographic Token & Authentication Variables
# Generate PEPPER with: openssl rand -hex 32
SECURITY_PEPPER=placeholder_string_minimum_32_characters_long_for_argon2_secret_injection
# Generate JWT_SECRET_KEY with: openssl rand -hex 64
JWT_SECRET_KEY=placeholder_string_minimum_64_characters_long_for_asymmetric_signature_verification
JWT_ALGORITHM=HS256
JWT_LEEWAY_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2 Password Hashing Derivation Costs
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Payload and Rate Limiting
MAX_UPLOAD_SIZE_BYTES=10485760
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_MUTATION_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=300

# Application Logging
LOG_LEVEL=INFO

# Hybrid Backup Configuration (PITR + Logical Cold Dumps)
BACKUP_BUCKET_NAME=provenance-backups
BACKUP_TMP_DIR=/tmp/provenance_backups
BACKUP_LOGICAL_RETENTION_COUNT=8
WALG_BASE_BACKUP_RETENTION_COUNT=4
WALG_COMPRESSION_METHOD=zstd