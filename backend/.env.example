ENVIRONMENT=development

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hey_you_should_tots_replace_this_to_a_strong_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=provenance_vault
# Optional DSN override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/provenance_vault

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO Server
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Client
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=provenance-covers
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/provenance-covers

# Cryptographic Token Variables
# Generate with: openssl rand -hex 32
SECURITY_PEPPER=placeholder_string_minimum_32_characters_long_for_argon2_secret_injection
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=placeholder_string_minimum_64_characters_long_for_asymmetric_signature_verification
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiting Limits
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_MUTATION_PER_MIN=30
RATE_LIMIT_READ_PER_MIN=300

# Application Logging
LOG_LEVEL=INFO

# Scheduled Database Backups
BACKUP_BUCKET_NAME=provenance-backups
BACKUP_RETENTION_COUNT=14
BACKUP_CRON_HOUR=3