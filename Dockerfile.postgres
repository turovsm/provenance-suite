FROM postgres:16-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    tar \
    zstd \
    lz4 \
    && curl -fsSL https://github.com/wal-g/wal-g/releases/download/v3.0.3/wal-g-pg-ubuntu-20.04-amd64.tar.gz -o /tmp/wal-g.tar.gz \
    && tar -xzf /tmp/wal-g.tar.gz -C /usr/local/bin/ \
    && mv /usr/local/bin/wal-g-pg-ubuntu-20.04-amd64 /usr/local/bin/wal-g \
    && chmod +x /usr/local/bin/wal-g \
    && rm -rf /tmp/wal-g.tar.gz /var/lib/apt/lists/*

RUN mkdir -p /docker-entrypoint-initdb.d && \
    echo 'echo "host replication all 0.0.0.0/0 scram-sha-256" >> "$PGDATA/pg_hba.conf"' > /docker-entrypoint-initdb.d/00-enable-replication.sh && \
    echo 'echo "host replication all 0.0.0.0/0 md5" >> "$PGDATA/pg_hba.conf"' >> /docker-entrypoint-initdb.d/00-enable-replication.sh && \
    chmod +x /docker-entrypoint-initdb.d/00-enable-replication.sh